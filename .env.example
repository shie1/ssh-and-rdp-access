SSH_DIR=~/.ssh/ [optional, default=~/.ssh/]

PASSWORD= [mandatory]

OTP_LABEL=Uncofigured [optional, default=Unconfigured]
OTP_ISSUER=SSH&RDP [optional, default=SSH&RDP]
OTP_SECRET=RQWW3RBDFWLhg5KPDO7JZDIH5DVZMJBL2P [mandatory]
OTP_CODE_ENABLED=true|false [optional, default=false]
# for 2FA setup on first startup, set to true to view the QR code and generate the OTP secret, then set to false for normal operation

TARGET=user@IP_ADDRESS [mandatory]

SSH_PORT=22 [optional, default=22]
RDP_PORT=3389 [optional, default=3389]

PORT=3000 [optional, default=3000]
BASE_URL=http://localhost:3000 [mandatory]
# the base URL of the server, including the port number

AUTH_DEBUG=false [optional, default=false]
# WARNING: Enabling this will log sensitive information such as passwords and OTP codes to the console. Use with caution and only in a secure environment.

REDIS_HOST= [optional, default=127.0.0.1:6379]

RDP_USERNAME= [mandatory]

IP_VALIDATION_SECONDS=600 [optional, default=600]
# The number of seconds an IP address is considered validated after a successful OTP verification. After this time, the IP address will need to re-verify with OTP to access the /key endpoint.

TRUST_PROXY=true|false|number [optional, default=false]